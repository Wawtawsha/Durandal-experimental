# =================================================================
# DURANDAL MCP SERVER - MINIMAL CONFIGURATION
# =================================================================
# Optional configuration for Durandal MCP Server
# Copy this file to .env if you need custom settings
#
# THE MCP SERVER WORKS WITHOUT ANY CONFIGURATION!
# Only create .env file if you want to customize these settings.

# =================================================================
# DATABASE CONFIGURATION (Optional)
# =================================================================

# SQLite Database Path (Default: ./durandal-mcp-memory.db)
DATABASE_PATH=./durandal-mcp-memory.db

# =================================================================
# SEMANTIC SEARCH / EMBEDDINGS (Optional)
# =================================================================
# Durandal uses a local embedding model (all-MiniLM-L6-v2, ~23MB, downloaded
# once) for semantic search — no API key, no network after first download.
# If the model can't load, the server falls back to lexical-only automatically.

# Disable semantic search entirely (lexical-only):
# DURANDAL_EMBEDDINGS=false

# Swap the embedding model (any transformers.js feature-extraction model):
# DURANDAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Minimum cosine similarity (0-1) for a semantic match (Default: 0.35):
# DURANDAL_SEMANTIC_MIN_SIM=0.35

# Max cosine distance to treat a new memory as a near-duplicate and consolidate
# it (Default: 0.08 ≈ similarity 0.92):
# DURANDAL_DEDUP_DISTANCE=0.08

# =================================================================
# LOGGING CONFIGURATION (Optional)
# =================================================================
#
# Durandal uses separate log levels for console and file output:
#
# Console Level - What you see in terminal (default: warn - quiet)
#   Recommended: Keep at 'warn' for clean terminal output
#
# File Level - Session history for debugging (default: info - detailed)
#   Recommended: Keep at 'info' for comprehensive troubleshooting logs
#   File location: ~/.durandal-mcp/logs/durandal-YYYY-MM-DD.log
#
# To configure interactively: durandal-mcp --configure

# Console log level: error, warn, info, debug (Default: warn)
CONSOLE_LOG_LEVEL=warn

# File log level: error, warn, info, debug (Default: info)
FILE_LOG_LEVEL=info

# Legacy: Single log level for both console and file (fallback only)
# Use CONSOLE_LOG_LEVEL and FILE_LOG_LEVEL instead for better control
# LOG_LEVEL=warn

# =================================================================
# UPDATE CONFIGURATION (Optional)
# =================================================================

# Enable/disable update checks (Default: true)
# Set to false or use NO_UPDATE_CHECK=1 to disable
UPDATE_CHECK_ENABLED=true

# Update check interval in milliseconds (Default: 86400000 = 24 hours)
UPDATE_CHECK_INTERVAL=86400000

# Show update notifications (Default: true)
UPDATE_NOTIFICATION=true

# Auto-update without confirmation (NOT RECOMMENDED, Default: false)
# When true, updates are installed automatically
AUTO_UPDATE=false

# Show pre-release versions (Default: false)
SHOW_PRERELEASE=false

# =================================================================
# THAT'S IT! No API keys, no complex setup required.
# =================================================================
#
# The MCP server will:
# ✅ Automatically create SQLite database
# ✅ Initialize schema on first run
# ✅ Work with Claude Code immediately
# ✅ Store and search memories
#
# Just run: node durandal-mcp-server.js