# Claude Code Configuration
# Default configuration for Claude Code (stdio transport)

# Transport Configuration
MCP_TRANSPORT=stdio
MCP_CLIENT=claude

# Logging
LOG_LEVEL=warn
VERBOSE=false
DEBUG=false
LOG_MCP_TOOLS=false

# Database
DATABASE_PATH=./durandal-mcp-memory.db

# Cache Configuration
CACHE_MAX_SIZE=1000
CACHE_TTL=3600000
CACHE_IMPORTANCE_THRESHOLD=0.5

# RAMR Configuration
RAMR_ENABLED=true
RAMR_PREFETCH=true
RAMR_CACHE_THRESHOLD=0.7

# Selective Attention
SELECTIVE_ATTENTION_ENABLED=true
RETENTION_THRESHOLD=0.3
ARCHIVE_AFTER_DAYS=30