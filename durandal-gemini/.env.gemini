# Google Gemini Configuration
# Configuration for Google Gemini (HTTP transport)

# Transport Configuration
MCP_TRANSPORT=http
MCP_CLIENT=gemini
MCP_PORT=8080
MCP_HOST=localhost

# Gemini API Key (required for authentication)
GEMINI_API_KEY=your-gemini-api-key-here

# Logging
LOG_LEVEL=info
VERBOSE=true
DEBUG=false
LOG_MCP_TOOLS=true

# Database
DATABASE_PATH=./durandal-mcp-memory.db

# Cache Configuration
CACHE_MAX_SIZE=1000
CACHE_TTL=3600000
CACHE_IMPORTANCE_THRESHOLD=0.5

# RAMR Configuration
RAMR_ENABLED=true
RAMR_PREFETCH=true
RAMR_CACHE_THRESHOLD=0.7

# Selective Attention
SELECTIVE_ATTENTION_ENABLED=true
RETENTION_THRESHOLD=0.3
ARCHIVE_AFTER_DAYS=30