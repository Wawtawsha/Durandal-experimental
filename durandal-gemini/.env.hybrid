# Hybrid Configuration
# Supports both Claude (stdio) and Gemini (HTTP) simultaneously

# Transport Configuration
MCP_TRANSPORT=hybrid
MCP_PORT=8080
MCP_HOST=localhost

# Gemini API Key (for Gemini connections)
GEMINI_API_KEY=your-gemini-api-key-here

# Logging (more verbose for multi-client)
LOG_LEVEL=info
VERBOSE=true
DEBUG=false
LOG_MCP_TOOLS=true

# Database (shared between all clients)
DATABASE_PATH=./durandal-mcp-memory.db

# Cache Configuration
CACHE_MAX_SIZE=2000  # Larger cache for multiple clients
CACHE_TTL=3600000
CACHE_IMPORTANCE_THRESHOLD=0.5

# RAMR Configuration
RAMR_ENABLED=true
RAMR_PREFETCH=true
RAMR_CACHE_THRESHOLD=0.7

# Selective Attention
SELECTIVE_ATTENTION_ENABLED=true
RETENTION_THRESHOLD=0.3
ARCHIVE_AFTER_DAYS=30

# Client-specific settings can be added here
# CLAUDE_SPECIFIC_SETTING=value
# GEMINI_SPECIFIC_SETTING=value