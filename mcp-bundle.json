{
  "name": "durandal-memory",
  "version": "4.0.0",
  "description": "Durandal Memory MCP Server - zero-config, local-only AI memory for Claude Code. Hybrid lexical (FTS5/BM25) + semantic (local embeddings + sqlite-vec) search with write-time consolidation.",
  "author": "Enterprise Data and Analytics",
  "license": "MIT",
  "keywords": [
    "memory",
    "ai",
    "claude",
    "mcp",
    "persistent",
    "context",
    "semantic-search",
    "hybrid-search",
    "embeddings"
  ],
  "mcpVersion": "1.0.0",
  "server": {
    "command": "node",
    "args": ["durandal-mcp-server.js"],
    "env": {}
  },
  "capabilities": {
    "tools": [
      "store_memory",
      "search_memories",
      "get_context",
      "get_memory",
      "update_memory",
      "delete_memory",
      "list_memories",
      "store_memories_batch",
      "export_memories",
      "import_memories",
      "rename_project",
      "delete_memories_where",
      "find_similar",
      "list_projects_sessions",
      "tag_memory",
      "optimize_memory",
      "backup_database",
      "get_status",
      "configure_logging",
      "get_logs"
    ]
  },
  "requirements": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "12.10.0",
    "sqlite-vec": "0.1.9",
    "@huggingface/transformers": "^4.2.0"
  },
  "files": [
    "durandal-mcp-server.js",
    "db.js",
    "embeddings.js",
    "logger.js",
    "errors.js",
    "test-runner.js",
    "update-checker.js",
    "db-discovery.js",
    "db-migrate.js",
    "assign-projects.js",
    "package.json",
    ".env.mcp-minimal"
  ],
  "installation": {
    "command": "npm install -g durandal-memory-mcp",
    "claudeCode": [
      "claude mcp add durandal-memory -- cmd /c durandal-mcp     (Windows)",
      "claude mcp add durandal-memory -- durandal-mcp            (macOS/Linux)"
    ]
  },
  "configuration": {
    "required": [],
    "optional": [
      { "name": "DATABASE_PATH", "description": "SQLite database path", "default": "~/.durandal-mcp/durandal-mcp-memory.db" },
      { "name": "DURANDAL_EMBEDDINGS", "description": "Set false to force lexical-only (no embedding model)", "default": "true" },
      { "name": "DURANDAL_EMBED_MODEL", "description": "transformers.js feature-extraction model id", "default": "Xenova/all-MiniLM-L6-v2" },
      { "name": "DURANDAL_SEMANTIC_MIN_SIM", "description": "Minimum cosine similarity for a semantic match", "default": "0.35" },
      { "name": "DURANDAL_DEDUP_DISTANCE", "description": "Max cosine distance to consolidate a near-duplicate", "default": "0.08" },
      { "name": "CONSOLE_LOG_LEVEL", "description": "Console log level (error|warn|info|debug)", "default": "warn" },
      { "name": "FILE_LOG_LEVEL", "description": "File log level (error|warn|info|debug)", "default": "info" }
    ]
  },
  "support": {
    "homepage": "https://github.com/Wawtawsha/durandal-memory-bridge#readme",
    "issues": "https://github.com/Wawtawsha/durandal-memory-bridge/issues",
    "email": "stephen.leonard@entdna.com"
  }
}
