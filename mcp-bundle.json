{
  "name": "durandal-memory",
  "version": "3.2.5",
  "description": "Durandal Memory MCP Server - zero-config AI memory system for Claude Code. Provides persistent memory, search, and context management over SQLite.",
  "author": "Enterprise Data and Analytics",
  "license": "MIT",
  "keywords": [
    "memory",
    "ai",
    "claude",
    "mcp",
    "persistent",
    "context"
  ],
  "mcpVersion": "1.0.0",
  "server": {
    "command": "node",
    "args": ["durandal-mcp-server-v3.js"],
    "env": {}
  },
  "capabilities": {
    "tools": [
      "store_memory",
      "search_memories",
      "get_context",
      "get_memory",
      "delete_memory",
      "optimize_memory",
      "get_status",
      "configure_logging",
      "get_logs",
      "list_projects_sessions"
    ]
  },
  "requirements": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "sqlite3": "^6.0.1"
  },
  "files": [
    "durandal-mcp-server-v3.js",
    "db-adapter.js",
    "mcp-db-client.js",
    "logger.js",
    "errors.js",
    "test-runner.js",
    "update-checker.js",
    "package.json",
    ".env.mcp-minimal"
  ],
  "installation": {
    "command": "npm install -g durandal-memory-mcp",
    "claudeCode": [
      "claude mcp add durandal-memory -- cmd /c durandal-mcp     (Windows)",
      "claude mcp add durandal-memory -- durandal-mcp            (macOS/Linux)"
    ]
  },
  "configuration": {
    "required": [],
    "optional": [
      { "name": "DATABASE_PATH", "description": "SQLite database path", "default": "~/.durandal-mcp/durandal-mcp-memory.db" },
      { "name": "CONSOLE_LOG_LEVEL", "description": "Console log level (error|warn|info|debug)", "default": "warn" },
      { "name": "FILE_LOG_LEVEL", "description": "File log level (error|warn|info|debug)", "default": "info" }
    ]
  },
  "support": {
    "homepage": "https://github.com/Wawtawsha/durandal-memory-bridge#readme",
    "issues": "https://github.com/Wawtawsha/durandal-memory-bridge/issues",
    "email": "stephen.leonard@entdna.com"
  }
}
