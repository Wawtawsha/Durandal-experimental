{
  "name": "durandal-memory-mcp",
  "version": "4.0.0",
  "description": "Durandal MCP Server - Zero-config AI memory for Claude Code. Hybrid lexical + semantic search (SQLite FTS5 + local embeddings), with write-time consolidation. Local-only, no API keys.",
  "main": "durandal-mcp-server.js",
  "bin": {
    "durandal-mcp": "durandal-mcp-server.js",
    "durandal-assign-projects": "assign-projects.js",
    "durandal-migrate": "db-migrate.js",
    "durandal-discover": "db-discovery.js"
  },
  "files": [
    "durandal-mcp-server.js",
    "db.js",
    "embeddings.js",
    "db-discovery.js",
    "db-migrate.js",
    "assign-projects.js",
    "logger.js",
    "errors.js",
    "test-runner.js",
    "update-checker.js",
    ".env.mcp-minimal",
    "README.md",
    "LICENSE",
    "UPDATE-POLICY.md",
    "mcp-bundle.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node durandal-mcp-server.js",
    "test": "node durandal-mcp-server.js --test",
    "test:smoke": "node test-mcp-smoke.js"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "model-context-protocol",
    "ai-memory",
    "persistent-memory",
    "claude",
    "sqlite",
    "zero-config",
    "memory-server",
    "semantic-search",
    "hybrid-search",
    "vector-search",
    "embeddings",
    "rag"
  ],
  "author": "Enterprise Data and Analytics",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "12.10.0",
    "sqlite-vec": "0.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wawtawsha/durandal-memory-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Wawtawsha/durandal-memory-bridge/issues"
  },
  "homepage": "https://github.com/Wawtawsha/durandal-memory-bridge#readme"
